# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Provide your Supabase project URL and public anonymous API key.
# When provided, ChinaStudy Connect connects directly to your Supabase PostgreSQL database,
# Supabase Auth, and private Storage buckets.
# If omitted, the platform gracefully uses local secure storage mode for testing.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
